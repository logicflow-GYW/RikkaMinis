<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      T-android-shortcut-icons-blank: foreground glyph color for the
      app-icon shortcut adaptive icons. The shortcut background is always
      @color/ic_launcher_background (#05101F — the app icon's dark navy
      base in BOTH light and dark themes), so the glyph must be a fixed
      LIGHT color in every theme: a dark glyph would vanish on the dark
      base, which is exactly the "light theme shows a dark-mode icon"
      mismatch reported against the previous light/dark flip. One fixed
      light color keeps the shortcuts legible and visually identical in
      both themes, matching the app icon's dark-base design. Fixed colors
      (not theme attrs) because the launcher process renders shortcut
      icons and can't resolve the app's ?attr tints.
    -->
    <color name="shortcut_icon_fg">#E6E8EB</color>
    <!--
      T-notification-brand: brand tint for notification small-icon/title
      coloring. Matches the app's teal primary (Theme.kt TealPrimary
      #2E8B8B). Fixed non-theme color because the notification tint applies
      in both light & dark system themes and the system shades the small
      icon itself; a theme-dependent value here buys nothing.
    -->
    <color name="notification_brand_color">#2E8B8B</color>
</resources>
