<?xml version="1.0" encoding="utf-8"?>
<!--
  T-android-app-icon-shortcuts: app-icon long-press quick actions.
  Android ships newChat / cameraChat. iOS (Shared/QuickActionRouter.swift)
  additionally ships voiceChat — no longer mirrored 1:1 by design, see the
  removal note below.
  Each shortcut launches MainActivity via a minis://action/<name> deep-link
  parsed by DeepLinkHandler → DeepLinkAction.{NewChat,NewCameraChat}.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_chat"
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_new_chat"
        android:shortcutShortLabel="@string/shortcut_new_chat_short"
        android:shortcutLongLabel="@string/shortcut_new_chat_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="@string/package_name"
            android:targetClass="com.rikkaminis.app.MainActivity"
            android:data="minis://action/new_chat" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <!--
      voice_chat shortcut removed: the in-composer mic button (its only landing
      UI) was cut, so this quick action would have opened a blank draft that did
      nothing. iOS still ships voiceChat; the 1:1 parity note above no longer
      holds for this one entry by design.
    -->
    <shortcut
        android:shortcutId="camera_chat"
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_camera_chat"
        android:shortcutShortLabel="@string/shortcut_camera_chat_short"
        android:shortcutLongLabel="@string/shortcut_camera_chat_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="@string/package_name"
            android:targetClass="com.rikkaminis.app.MainActivity"
            android:data="minis://action/camera_chat" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
