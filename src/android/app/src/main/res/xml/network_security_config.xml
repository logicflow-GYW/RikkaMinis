<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- T354: allow cleartext HTTP globally so user-configured provider
         endpoints (private/LAN LLM servers like http://192.168.x.x:port or
         http://my-host:8080) work. Minis is a tool where the user supplies
         the endpoint — they own the trust decision. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- [GH#258] Also trust user-installed CAs. Same posture as the
                 cleartext decision above: the user supplies the endpoint (and
                 with it the proxy/MITM box doing the TLS inspection), so the
                 trust decision is theirs to make. Without this, a user running
                 their own TLS-terminating proxy sees certificate errors on an
                 app that already permits cleartext to the same host. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <!-- Pre-T354 entry kept for explicitness; the base-config above already
         covers localhost/127.0.0.1 (OAuth callback server). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
